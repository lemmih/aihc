    Test.Native.Observed
    Test.Native.Primitive
    Test.Native.Runtime
    Test.Native.Spec
    Test.Wasm.Spec

  build-depends:
    aeson,
    aihc,
    aihc-hackage,
    aihc-package-plan,
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    haskeline,
    hedgehog,
    prettyprinter,
    process,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    temporary,
    text,
    time,
    yaml,

test-suite dev-spec
  import: test-options
  type: exitcode-stdio-1.0
  default-extensions: OverloadedStrings
  hs-source-dirs:
    dev/test
    dev/src
    compiler/grin/fuzz
    compiler/grin/test

  main-is: Spec.hs
  other-modules:
    Aihc.Dev.ExtractHi
    Aihc.Dev.ExtractHi.Compare
    Aihc.Dev.ExtractHi.GhcSession
    Aihc.Dev.ExtractHi.ToResolveIface
