  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aeson-pretty >=0.8 && <0.9,
    aihc,
    aihc-internal,
    aihc-parser,
    aihc-tc,
    aihc-tc:fuzz,
    aihc-template-haskell,
    async,
    base >=4.16 && <5,
    bytestring,
    containers,
    deepseq,
