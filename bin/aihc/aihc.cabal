    Aihc.Lir.RegAlloc
    Aihc.Lir.Resolve
    Aihc.Lir.Syntax
    Aihc.Llvm.Lir
    Aihc.Native
    Aihc.Prim.Wiring
    Aihc.Wasm
    Aihc.Wasm.Lir

  other-modules:
    Aihc.Cli.Cbor
    Aihc.Cli.InterfaceTyCons
    Aihc.Cli.TaskGraph
    Aihc.CompilerBuildIdentity
    Aihc.DataFiles
    Aihc.Fc.Desugar.Value
    Aihc.Grin.Analysis
    Aihc.Lir.Convert
    Aihc.Native.Elf
    Aihc.Native.MachO
    Aihc.Native.Move
    Aihc.Native.Object
    Paths_aihc

  autogen-modules:
    Aihc.CompilerBuildIdentity
    Paths_aihc

  hs-source-dirs:
    src
    ../../components/aihc-tc/prim-wiring
    compiler/amd64/src
    compiler/arm64/src
    compiler/fc/src
    compiler/grin/src
    compiler/lir/src
    compiler/llvm/src
    compiler/native/src
    compiler/wasm/src

  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aihc-cpp,
    aihc-hackage,
    aihc-package-plan,
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    array >=0.5 && <0.6,
    async,
    base >=4.16 && <5,
    binary >=0.8 && <0.9,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.8,
    cryptohash-sha256,
    deepseq,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    haskeline >=0.8 && <0.9,
    libffi >=0.2 && <0.3,
    megaparsec >=9.0 && <10,
    optparse-applicative >=0.16 && <0.19,
    prettyprinter,
    process >=1.6 && <1.8,
    stm >=2.5 && <2.6,
    text >=2.1.4 && <2.2,
    transformers,
    unix >=2.7 && <2.9,

  default-extensions: OverloadedStrings
  ghc-options: -Wall
  default-language: GHC2021

executable aihc
  main-is: Main.hs
  hs-source-dirs: exe
  build-depends:
    aihc,
    base >=4.16 && <5,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021

executable aihc-dev
  main-is: Main.hs
  hs-source-dirs:
    dev/exe
    dev/src
    compiler/grin/fuzz
    compiler/grin/test

  other-modules:
    Aihc.Dev.ExtractHi
    Aihc.Dev.ExtractHi.Compare
    Aihc.Dev.ExtractHi.GhcSession
    Aihc.Dev.ExtractHi.ToResolveIface
    Aihc.Dev.ExtractHi.Types
    Aihc.Dev.Fuzz
    Aihc.Dev.Fuzz.CLI
    Aihc.Dev.Fuzz.Registry
    Aihc.Dev.Fuzz.TUI
    Aihc.Grin.Fuzz
    Test.Grin.Arbitrary

  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aeson-pretty >=0.8 && <0.9,
    aihc,
    aihc-parser,
    aihc-tc,
    aihc-tc:fuzz,
    async,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.8,
    deepseq,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    ghc >=9.12 && <9.13,
    hedgehog >=1.4 && <1.6,
    optparse-applicative >=0.16 && <0.19,
    prettyprinter,
    process >=1.6 && <1.8,
    stm >=2.5 && <2.6,
    tasty-hedgehog,
    terminal-size >=0.3.2 && <0.4,
    text >=1.2.3 && <2.2,
    time,
    unix >=2.7 && <2.9,
    yaml >=0.11 && <0.12,

  default-extensions: OverloadedStrings
  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021

common test-options
  ghc-options:
    -Wall
    -threaded
    -rtsopts
    "-with-rtsopts=-N -M10G"

  default-language: GHC2021

test-suite spec
  import: test-options
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    compiler/fc/test
    compiler/fc/common
    compiler/grin/test
    compiler/lir/test
    compiler/native/test
    compiler/amd64/test
    compiler/arm64/test
    compiler/llvm/test
    compiler/wasm/test
    test-support

  main-is: Spec.hs
  other-modules:
