custom-setup
  setup-depends:
    Cabal >=3.14 && <3.17,
    base >=4.16 && <5,
    directory,
    filepath,
    process,

library
  exposed-modules:
    Aihc.Amd64.Assemble
    Aihc.Amd64.Lir
    Aihc.Amd64.Text
    Aihc.Arm64.Assemble
    Aihc.Arm64.Lir
