cabal-version: 3.8
name: identity-fixture
version: 0
build-type: Custom
data-files: runtime.h

custom-setup
  setup-depends:
    Cabal >=3.14 && <3.17,
    base,
    bytestring,
    cryptohash-sha256,
    directory,
    filepath,

library
  exposed-modules: Selected
  other-modules: Aihc.CompilerBuildIdentity
  autogen-modules: Aihc.CompilerBuildIdentity
  hs-source-dirs: src
  build-depends:
    base,
    identity-dependency,

  default-language: Haskell2010

executable identity-fixture
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    identity-fixture,

  default-language: Haskell2010
