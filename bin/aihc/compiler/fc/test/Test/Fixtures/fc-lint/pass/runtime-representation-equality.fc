scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.tType;
  2.tLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.tType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.tType;
  2.tType :: 2.tType;
  2.t[] :: ∀(a : 2.tType). 2.tType;
  2.vBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.vLifted :: 2.tLevity;
  2.vTupleRep :: 2.t[] 2.tRuntimeRep 2.→ 2.tRuntimeRep;
  2.v[] :: ∀(a : 2.tType). 2.t[] a

import synonyms
  2.tLiftedRep = 2.vBoxedRep 2.vLifted;
  2.tType = 2.tTYPE 2.tLiftedRep

val 1.vid :: ∀(a : 2.tType). a 2.→ a
 = Λ(a : 2.tType).
  λ(x : a).
    x

val 1.vuse :: ∀(r : 2.tRuntimeRep) (s : 2.tRuntimeRep) (a : 2.tTYPE r). FUN @(2.vTupleRep (2.v[] 2.tRuntimeRep)) @2.tLiftedRep (r ~ s) (FUN @(2.vTupleRep (2.v[] 2.tRuntimeRep)) @2.tLiftedRep (2.tLiftedRep ~ s) (FUN @r @r a a))
 = Λ(r : 2.tRuntimeRep).
  Λ(s : 2.tRuntimeRep).
    Λ(a : 2.tTYPE r).
      λ(first : r ~ s).
        λ(second : 2.tLiftedRep ~ s).
          1.vid @a
