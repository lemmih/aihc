scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.tType;
  2.tLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.tType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.tType;
  2.tType :: 2.tType;
  2.vBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.vLifted :: 2.tLevity

import synonyms
  2.tLiftedRep = 2.vBoxedRep 2.vLifted;
  2.tType = 2.tTYPE 2.tLiftedRep

pub type 1.tInt :: 2.tType {
    pub 1.vI :: 1.tInt
}

pub type 1.tAge :: 2.tType {}

axiom 1.$ax$Age : 1.tAge ~R 1.tInt

pub type 1.tBox (a : 2.tType) :: 2.tType {}

val 1.vproof :: 1.tAge ~ 1.tInt
 = coercion (nth-co 0 (app-co (refl 1.tBox) (axiom-co 1.$ax$Age)))
