; A wide straight-line function. Both pools hold every volatile register,
; so the function is a leaf with no frame at all, and on AMD64 a result that
; takes the register of an operand that dies at its instruction computes in
; place.
func @wide(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64) -> i64 cc c {
entry:
  %g = add i64 %a, %b
  %h = add i64 %c, %d
  %i = add i64 %e, %f
  %j = mul i64 %g, %h
  %k = mul i64 %i, %a
  %l = add i64 %j, %k
  %m = add i64 %l, %b
  %n = add i64 %m, %c
  return %n
}
