; expect: -128, -128
; xfail: aihc-amd64
; xfail: aihc-arm64
; xfail: aihc-llvm
; xfail: aihc-wasm
; reason: Truncation must precede the signed integer range check.

func @main() -> (i8, i8) {
entry:
  %fraction = ftoi.s f64 -128.5 to i8
  %minimum = ftoi.s f64 -128.0 to i8
  return %fraction, %minimum
}
