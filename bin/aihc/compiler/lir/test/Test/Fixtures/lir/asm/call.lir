; Values live across C calls. %x and %a each live across a call, so the
; allocator gives them preserved registers, which the C callee keeps, and
; they survive where they are without a reload and without the allocator
; splitting an interval. The function is a C function, so it saves the
; preserved registers it uses. The result of each call is consumed from the
; result register it arrives in.
extern func @helper(i64) -> i64 cc c

func @twice(%x: i64) -> i64 cc c {
entry:
  %a = call @helper(%x)
  %b = call @helper(%a)
  %c = add i64 %a, %b
  %d = add i64 %c, %x
  return %d
}
