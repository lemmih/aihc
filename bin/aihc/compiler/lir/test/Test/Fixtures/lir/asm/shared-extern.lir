; Repeated external aihc calls share one branch relocation on ARM64.
; A single external call retains its direct branch.
extern func @shared(i64)
extern func @single(i64)
extern func @eight(i64)

func @many() {
entry:
  call @shared(0)
  call @shared(1)
  call @shared(2)
  call @shared(3)
  call @shared(4)
  call @shared(5)
  call @shared(6)
  call @shared(7)
  call @shared(8)
  tailcall @shared(9)
}

func @one() {
entry:
  tailcall @single(0)
}

; Eight calls do not use a stub.
func @boundary() {
entry:
  call @eight(0)
  call @eight(1)
  call @eight(2)
  call @eight(3)
  call @eight(4)
  call @eight(5)
  call @eight(6)
  tailcall @eight(7)
}
