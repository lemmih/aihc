; A tail call whose arguments overrun the argument registers of both targets.
; The outgoing block is built below the frame and then moved into the place of
; the incoming block, so the saved registers have to go back while the stack
; pointer still sits below the frame.
func @spread(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64, %i: i64, %j: i64) {
entry:
  %k = add i64 %a, %j
  tailcall @spread(%k, %b, %c, %d, %e, %f, %g, %h, %i, %j)
}
