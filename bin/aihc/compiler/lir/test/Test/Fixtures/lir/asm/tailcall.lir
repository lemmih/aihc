; A tail call. The arguments are hinted with the argument registers, so
; the values the loop carries stay where the convention wants them and the
; tail call is one move and a branch. An aihc function preserves nothing and
; this one calls nothing, so there is no frame to take down.
extern func @done(i64)

func @count(%n: i64, %acc: i64) {
entry:
  %stop = eq i64 %n, 0
  br %stop, finish(%acc), again(%n, %acc)

again(%i: i64, %total: i64):
  %next = sub i64 %i, 1
  %sum = add i64 %total, %i
  tailcall @count(%next, %sum)

finish(%result: i64):
  tailcall @done(%result)
}
